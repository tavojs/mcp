{
  "name": "@tavojs/mcp",
  "version": "1.0.0",
  "description": "Read-only Model Context Protocol server for Tavo.js documentation and project inspection.",
  "type": "module",
  "license": "MIT",
  "author": "Hrachya Martirosyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tavojs/mcp.git"
  },
  "homepage": "https://github.com/tavojs/mcp#readme",
  "bugs": {
    "url": "https://github.com/tavojs/mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "tavo-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "docs/remote-deployment.md",
    "schemas",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-content.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:generate": "npm run build && node scripts/generate-content-schema.mjs",
    "schema:check": "npm run build && node scripts/generate-content-schema.mjs --check",
    "test:search-eval": "npm run build && node --test tests/search-evaluation.test.mjs",
    "sync:content": "node scripts/sync-content.mjs",
    "check:content": "node scripts/sync-content.mjs --check",
    "check:content:remote": "node scripts/sync-content.mjs --check --source=https://tavojs.dev/.well-known/tavo-docs-v1.json",
    "validate": "npm run check:content && npm run schema:check && npm run typecheck && npm test && npm run test:integration && npm run format:check",
    "release:check": "npm run validate && npm run check:content:remote && npm pack --dry-run && npm audit --omit=dev",
    "export:public": "node scripts/export-public.mjs",
    "sync:public": "node scripts/export-public.mjs --sync",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "release": "npm run build && npm test && npm publish --access public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "minisearch": "^7.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
