{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generatedAt": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "website",
              "cli",
              "framework",
              "ui"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "quickstart",
              "guide",
              "concept",
              "reference"
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtime": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "browser",
                "server",
                "build"
              ]
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "type": "string",
                  "pattern": "^\\/.*"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "href",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "canonicalPath": {
            "type": "string",
            "pattern": "^\\/.*"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "markdown": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "markdown"
              ],
              "additionalProperties": false
            }
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "section",
          "slug",
          "title",
          "description",
          "keywords",
          "canonicalPath",
          "sections",
          "sourceId"
        ],
        "additionalProperties": false
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "core": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entrypoint": {
                "type": "string",
                "minLength": 1
              },
              "symbols": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "anchor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string"
                    },
                    "signature": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "runtime": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "browser",
                          "server",
                          "build"
                        ]
                      }
                    },
                    "stability": {
                      "type": "string"
                    },
                    "related": {
                      "type": "string",
                      "pattern": "^\\/.*"
                    }
                  },
                  "required": [
                    "name",
                    "description"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "entrypoint",
              "symbols"
            ],
            "additionalProperties": false
          }
        },
        "ui": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entrypoint": {
                "type": "string",
                "minLength": 1
              },
              "symbols": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "anchor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string"
                    },
                    "signature": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "runtime": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "browser",
                          "server",
                          "build"
                        ]
                      }
                    },
                    "stability": {
                      "type": "string"
                    },
                    "related": {
                      "type": "string",
                      "pattern": "^\\/.*"
                    }
                  },
                  "required": [
                    "name",
                    "description"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "entrypoint",
              "symbols"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "core",
        "ui"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "importPath": {
            "type": "string",
            "minLength": 1
          },
          "cssImportPath": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "stable",
              "experimental"
            ]
          },
          "summary": {
            "type": "string"
          },
          "whenToUse": {
            "type": "string"
          },
          "avoidWhen": {
            "type": "string"
          },
          "props": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "default": false,
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "defaultValue": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type",
                "required",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "requiredImports": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "title",
                "code"
              ],
              "additionalProperties": false
            }
          },
          "composition": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "accessibilityGuidance": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string"
              },
              "checklist": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "summary",
              "checklist"
            ],
            "additionalProperties": false
          },
          "searchTerms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capability": {
            "type": "string"
          },
          "maturity": {
            "type": "string"
          },
          "requiredImports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stateOwnership": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preview": {
            "type": "object",
            "properties": {
              "available": {
                "type": "boolean"
              },
              "fixture": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "available",
              "fixture"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "slug",
          "category",
          "importPath",
          "description",
          "summary",
          "whenToUse",
          "avoidWhen",
          "props",
          "examples",
          "composition",
          "accessibilityGuidance",
          "searchTerms"
        ],
        "additionalProperties": {}
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cssVariable": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "cssVariable",
          "group"
        ],
        "additionalProperties": {}
      }
    },
    "commands": {
      "type": "object",
      "properties": {
        "tavo": {
          "type": "string"
        },
        "tavoUi": {
          "type": "string"
        }
      },
      "required": [
        "tavo",
        "tavoUi"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "contentHash",
    "generatedAt",
    "sources",
    "documents",
    "api",
    "components",
    "tokens",
    "commands"
  ],
  "additionalProperties": false,
  "$id": "https://tavo.dev/schemas/tavo-docs-v1.schema.json",
  "title": "Tavo.js Public Documentation Manifest v1"
}
